{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tauri Frame Probe",
  "version": "0.1.0",
  "identifier": "local.tauri.frameprobe",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Tauri Frame Probe", "width": 1100, "height": 780 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false }
}
